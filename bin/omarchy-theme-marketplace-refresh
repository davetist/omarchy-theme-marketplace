#!/bin/bash

# omarchy:summary=Refresh cached Omarchy theme marketplace data
# omarchy:group=theme
# omarchy:name=marketplace refresh
# omarchy:examples=omarchy theme marketplace refresh

set -euo pipefail

if ! command -v curl >/dev/null 2>&1; then
  echo "curl is required to refresh the theme marketplace" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required to parse the theme marketplace data" >&2
  exit 1
fi

if ! command -v magick >/dev/null 2>&1; then
  echo "ImageMagick is required to prepare marketplace previews" >&2
  exit 1
fi

SOURCE_URL="https://raw.githubusercontent.com/limehawk/omarchy-theme-website/main/src/data/themes-data.json"
SOURCE_API_URL="https://api.github.com/repos/limehawk/omarchy-theme-website/contents/src/data/themes-data.json?ref=main"
CACHE_DIR="$HOME/.cache/omarchy/theme-marketplace"
PREVIEW_DIR="$CACHE_DIR/previews"
CACHE_FILE="$CACHE_DIR/themes.tsv"
SOURCE_FILE="$CACHE_DIR/themes-data.json"
SOURCE_HASH_FILE="$CACHE_DIR/source.sha256"
PLACEHOLDER_PREVIEW="$CACHE_DIR/fetching-preview.jpg"
PREVIEW_MAX_SIZE="1000x1000>"
PREVIEW_QUALITY="82"
FIRST_PREVIEW_COUNT="10"
FIRST_PREVIEW_JOBS="4"
PREVIEW_JOBS="8"
SOURCE_CONNECT_TIMEOUT="10"
SOURCE_MAX_TIME="30"

notify_marketplace_error() {
  local message="$1"

  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical "Theme marketplace" "$message" || true
  fi

  echo "Theme marketplace: $message" >&2
}

fetch_marketplace_source() {
  local output_file="$1"
  local tmp_api_response

  if curl -fsSL --connect-timeout "$SOURCE_CONNECT_TIMEOUT" --max-time "$SOURCE_MAX_TIME" "$SOURCE_URL" -o "$output_file"; then
    return 0
  fi

  tmp_api_response=$(mktemp)
  if curl -fsSL \
    --connect-timeout "$SOURCE_CONNECT_TIMEOUT" \
    --max-time "$SOURCE_MAX_TIME" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "$SOURCE_API_URL" \
    -o "$tmp_api_response" &&
    jq -r '.content // empty | gsub("\\n"; "") | @base64d' "$tmp_api_response" >"$output_file"; then
    rm -f "$tmp_api_response"
    [[ -s $output_file ]]
    return
  fi

  rm -f "$tmp_api_response"
  return 1
}

if [[ ${1:-} == "--preview-worker" ]]; then
  image_url="${2:-}"
  preview_path="${3:-}"

  if [[ -z $image_url || -z $preview_path || -f $preview_path ]]; then
    exit 0
  fi

  tmp_image=$(mktemp)
  cleanup_preview_worker() {
    rm -f "$tmp_image"
  }
  trap cleanup_preview_worker EXIT

  curl --fail --silent --show-error --location --output "$tmp_image" "$image_url" || exit 0
  magick "$tmp_image" -auto-orient -resize "$PREVIEW_MAX_SIZE" -strip -quality "$PREVIEW_QUALITY" "$preview_path" || exit 0
  exit 0
fi

mkdir -p "$PREVIEW_DIR"

if [[ ! -f $PLACEHOLDER_PREVIEW ]]; then
  magick -size 1000x563 xc:'#111318' \
    -fill '#39dce8' -gravity center -pointsize 44 \
    -annotate 0 'Fetching themes...' \
    "$PLACEHOLDER_PREVIEW"
fi

tmp_json=$(mktemp)
tmp_cache=$(mktemp)
tmp_first_jobs=$(mktemp)
tmp_rest_jobs=$(mktemp)

cleanup() {
  rm -rf "$tmp_json" "$tmp_cache" "$tmp_first_jobs" "$tmp_rest_jobs"
}
trap cleanup EXIT

run_preview_jobs() {
  local job_file="$1"
  local jobs="$2"

  if [[ ! -s $job_file ]]; then
    return
  fi

  xargs -r -0 -n 2 -P "$jobs" bash "$0" --preview-worker <"$job_file"
}

queue_preview_jobs() {
  local cache_file="$1"
  local first_jobs_file="$2"
  local rest_jobs_file="$3"
  local index=0
  local theme_name name repo_url image_url preview_path

  while IFS=$'\t' read -r theme_name name repo_url image_url preview_path; do
    index=$((index + 1))

    if [[ -z $image_url || -z $preview_path || -f $preview_path ]]; then
      continue
    fi

    if ((index <= FIRST_PREVIEW_COUNT)); then
      printf '%s\0%s\0' "$image_url" "$preview_path" >>"$first_jobs_file"
    else
      printf '%s\0%s\0' "$image_url" "$preview_path" >>"$rest_jobs_file"
    fi
  done <"$cache_file"
}

if ! fetch_marketplace_source "$tmp_json"; then
  notify_marketplace_error "Could not fetch the marketplace source."
  exit 1
fi

new_hash=$(sha256sum "$tmp_json" | cut -d' ' -f1)
old_hash=$(cat "$SOURCE_HASH_FILE" 2>/dev/null || true)

if [[ $new_hash == "$old_hash" && -f $CACHE_FILE ]]; then
  queue_preview_jobs "$CACHE_FILE" "$tmp_first_jobs" "$tmp_rest_jobs"
  run_preview_jobs "$tmp_first_jobs" "$FIRST_PREVIEW_JOBS"
  run_preview_jobs "$tmp_rest_jobs" "$PREVIEW_JOBS"
  exit 0
fi

if ! jq -r --arg preview_dir "$PREVIEW_DIR" '
  def clean_repo:
    sub("/+$"; "");

  def theme_name_from_repo:
    clean_repo
    | split("/")[-1]
    | sub("\\.git$"; "")
    | sub("^omarchy-"; "")
    | sub("-theme$"; "")
    | ascii_downcase;

  .[]
  | {
      id: ((.id // .slug) // ""),
      name: (.name // ""),
      repo_url: ((.canonical_github_url // .github_url) // ""),
      image_url: (.preview_url // "")
    }
  | .theme_name = (.repo_url | theme_name_from_repo)
  | .preview_id = ((if .id == "" then .theme_name else .id end) | ascii_downcase | gsub("[^a-z0-9._-]"; "-"))
  | select(.theme_name != "" and .name != "" and .repo_url != "" and .image_url != "")
  | [.theme_name, .name, .repo_url, .image_url, ($preview_dir + "/" + .preview_id + ".jpg")]
  | @tsv
' "$tmp_json" >"$tmp_cache"; then
  notify_marketplace_error "Could not parse the marketplace source."
  exit 1
fi

parsed_count=$(wc -l <"$tmp_cache")

if ((parsed_count < 10)); then
  notify_marketplace_error "Could not parse the marketplace source."
  exit 1
fi

cp "$tmp_json" "$SOURCE_FILE"
printf '%s\n' "$new_hash" >"$SOURCE_HASH_FILE"
mv "$tmp_cache" "$CACHE_FILE"

find "$PREVIEW_DIR" -maxdepth 1 -type f ! -name '*.jpg' -delete

queue_preview_jobs "$CACHE_FILE" "$tmp_first_jobs" "$tmp_rest_jobs"
run_preview_jobs "$tmp_first_jobs" "$FIRST_PREVIEW_JOBS"
run_preview_jobs "$tmp_rest_jobs" "$PREVIEW_JOBS"
